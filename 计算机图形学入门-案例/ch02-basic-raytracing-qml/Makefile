# Makefile for the Chapters 2-4 Qt/QML ray-tracing example.
#
# The project must be built through build.ps1 because Qt 6.9 may fail to
# process the original Chinese project path when moc or qmlimportscanner is
# invoked on Windows. The script maps the project to an ASCII drive letter,
# configures CMake with Ninja, and writes the executable to build-ascii/.
#
# The recipes intentionally use PowerShell for process management and the
# existing build script. This keeps the command line identical in PowerShell,
# Command Prompt, and the Qt MinGW environment.

# Keep all generated targets available even when a file with the same name is
# present. This is important because the build script must be rerun after QML
# or C++ source changes.
.PHONY: all build run stop clean help

# The executable generated by build.ps1. Use a forward slash so GNU Make can
# parse the path consistently; Windows accepts it when launching the file.
APP := build-ascii/ch02_raytracing.exe
# Keep a native Windows spelling for the launch recipe so the command remains
# readable and does not depend on Make's backslash substitution rules.
APP_WIN := .\build-ascii\ch02_raytracing.exe

# The PowerShell command used by every recipe that needs the Windows shell.
# -NoProfile avoids user profile aliases changing the behavior of the build.
POWERSHELL := powershell.exe -NoProfile -ExecutionPolicy Bypass

# The default target is the complete workflow most users expect.
all: run

# Configure and compile the latest C++ and QML sources through the project's
# path-safe build script. A failing script propagates a non-zero status to
# GNU Make, so later targets are not run after a failed build.
build:
	$(POWERSHELL) -File .\build.ps1

# Stop an older instance before linking. Windows keeps a running executable
# locked, which can otherwise make the linker fail during an incremental build.
stop:
	$(POWERSHELL) -Command "Get-Process ch02_raytracing -ErrorAction SilentlyContinue | Stop-Process -Force; exit 0"

# Rebuild and then launch the freshly generated application. The executable is
# intentionally run in the foreground so its log output and exit status remain
# visible in the same terminal.
run: stop build
	$(APP_WIN)

# Remove only generated build directories. This target is recoverable because
# it never touches source files, QML files, or the checked-in documentation.
clean:
	$(POWERSHELL) -Command "Remove-Item -LiteralPath '.\build-ascii','.\build' -Recurse -Force -ErrorAction SilentlyContinue"

# Print the supported commands without requiring a separate README lookup.
help:
	@echo Usage: mingw32-make ^<target^>
	@echo.
	@echo Targets:
	@echo   run    Stop the old process, build, and launch the example
	@echo   build  Configure and compile through build.ps1
	@echo   stop   Stop a running ch02_raytracing.exe
	@echo   clean  Remove generated build directories
	@echo   help   Show this help text
